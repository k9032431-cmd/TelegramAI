# Bu faýly ".env" diýip göçürip, öz açarlaryňyzy ýazyň.
# .env faýlyny HIÇ HAÇAN GitHub-a goýmaň!

# @BotFather-dan alnan token
TELEGRAM_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# --- AI hyzmaty (mugt) ---
# 1-nji wariant: Groq (maslahat berilýär, örän çalt)
AI_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile

# 2-nji wariant: Google Gemini (ýokardaky 3 setiri şeýle çalyşyň)
# AI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxx
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-2.5-flash

# 3-nji wariant: OpenRouter (":free" bilen gutarýan modeller mugt)
# AI_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxx
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Goşmaça (hökman däl) ---
# Botuň häsiýeti
SYSTEM_PROMPT=Sen peýdaly we dostlukly kömekçi. Ulanyjy haýsy dilde ýazsa, şol dilde jogap ber.
# Näçe soňky habary ýatda saklasyn
HISTORY_LIMIT=20
# Diňe şu Telegram ID-li adamlar ulanyp bilsin (otur bilen). Boş = hemmeler.
ALLOWED_USERS=
